<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.openipc.devourer-sta</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/libexec/devourer-sta/devourer-sta-run.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/var/log/devourer-sta-daemon.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/devourer-sta-daemon.log</string>
</dict>
</plist>
